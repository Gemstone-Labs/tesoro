# Copy to .env.local (gitignored). See docs/rpc.md.
# Browser: single-account reads and sends. Public by design: use a domain-restricted key.
NEXT_PUBLIC_SOLANA_RPC=
# Server: reads and sends (Alchemy or similar).
TESORO_BASE_RPC=
# Server only: list queries (getProgramAccounts). Defaults to https://api.devnet.solana.com.
TESORO_GPA_RPC=
# Keeper (loads this file when its own env is unset): sends/reads and lists.
KEEPER_RPC=
KEEPER_GPA_RPC=
# Show Extend on SOL Positions with an open Advance. Set to 1 only once tesoro_core has the extend_native_advance upgrade on devnet (ADR 0008).
NEXT_PUBLIC_EXTEND_ADVANCE=

# Waitlist CAPTCHA (Cloudflare Turnstile). Leave both empty locally: verification is skipped.
# In production set both: the site key is public, the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
