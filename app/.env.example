# Copy to .env.local (gitignored). See docs/rpc.md; every variable per deployment is in ../docs/environments.md.
# Cluster: "test" (default; devnet) or "mainnet". Mainnet has no default RPCs: set the ones below, or boot fails.
TESORO_CLUSTER=
NEXT_PUBLIC_TESORO_CLUSTER=
# Public origin of this deployment (canonical links, email links). Test host: https://test.playtesoro.com.
NEXT_PUBLIC_SITE_URL=
# Mainnet only: Ethereum and HyperEVM browser RPCs (Alchemy, key restricted by domain). Test mode: NEXT_PUBLIC_HOODI_RPC / NEXT_PUBLIC_HYPEREVM_RPC are optional.
NEXT_PUBLIC_ETHEREUM_RPC=
NEXT_PUBLIC_HYPEREVM_RPC=
# Browser: single-account reads and sends. Public by design: use a domain-restricted key.
NEXT_PUBLIC_SOLANA_RPC=
# Server: reads and sends (Alchemy or similar).
TESORO_BASE_RPC=
# Server only: list queries (getProgramAccounts). Defaults to https://api.devnet.solana.com.
TESORO_GPA_RPC=
# Keeper (loads this file when its own env is unset): sends/reads and lists.
KEEPER_RPC=
KEEPER_GPA_RPC=
# Show Extend on SOL Positions with an open Advance. Set to 1 only once tesoro_core has the extend_native_advance upgrade on devnet (ADR 0008).
NEXT_PUBLIC_EXTEND_ADVANCE=

# Email notifications (Resend). NOTIFY_FROM must be an address on the verified sending subdomain.
RESEND_API_KEY=
NOTIFY_FROM="Tesoro <hello@mail.playtesoro.com>"
# Shared with the keeper (which also needs NOTIFY_URL=<this deployment's site URL>/api/notify/ with the trailing slash).
NOTIFY_SECRET=
# Keeper alerts (commits stuck, job failing, low balance) are mailed to these founders, comma separated. Never taken from a request.
ALERT_EMAILS=

# Waitlist CAPTCHA (Cloudflare Turnstile). Leave both empty locally: verification is skipped.
# In production set both: the site key is public, the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mainnet cluster (NEXT_PUBLIC_TESORO_CLUSTER=mainnet): real-token vaults the Wallet lists. Unset = that chain's tab says it is not available yet.
NEXT_PUBLIC_ETHEREUM_RPC=
NEXT_PUBLIC_HYPEREVM_RPC=
NEXT_PUBLIC_WSTETH_VAULT=
NEXT_PUBLIC_LIDO_ZAP=
NEXT_PUBLIC_KHYPE_VAULT=
NEXT_PUBLIC_KINETIQ_ZAP=
