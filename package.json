{
  "name": "tesoro",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build:programs": "./scripts/build-programs.sh",
    "test:programs": "cargo test --workspace",
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test",
    "dev": "pnpm --filter @tesoro/app dev",
    "build:app": "pnpm --filter @tesoro/app build",
    "prepare": "git config core.hooksPath .githooks || true"
  }
}
